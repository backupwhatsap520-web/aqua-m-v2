# Firebase web config. Copy this file to .env and fill THAT in.
#
#   cp .env.example .env
#
# Fill in from the Firebase console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
#
# Do NOT fill in this file. .env is gitignored; .env.example is committed, so
# anything written here goes to GitHub.
#
# With any of these left blank the dashboard still loads: it shows skeletons and
# a "cannot reach the database" notice instead of a white screen. That is the
# state a judge sees if the venue Wi-Fi misbehaves, so it is worth checking.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
